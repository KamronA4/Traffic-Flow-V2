# AWS Configuration Template
# Copy this to .env and fill in your values

# AWS Account Configuration
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# ECS Configuration
CLUSTER_NAME=village-cluster
SERVICE_NAME=village-traffic-collector
ECR_REPOSITORY=village-traffic-collector
TASK_DEFINITION_FAMILY=village-traffic-collector

# Network Configuration
VPC_ID=vpc-xxxxxxxx
SUBNET_ONE=subnet-xxxxxxxx
SUBNET_TWO=subnet-yyyyyyyy
SECURITY_GROUP_ID=sg-xxxxxxxx

# EFS Configuration (for persistent SQLite storage)
EFS_FILE_SYSTEM_ID=fs-xxxxxxxx
EFS_ACCESS_POINT_ID=fsap-xxxxxxxx

# Service Discovery (optional)
SERVICE_DISCOVERY_ID=srv-xxxxxxxx

# Secrets Manager ARNs
TOMTOM_API_KEY_SECRET=arn:aws:secretsmanager:us-east-1:123456789012:secret:village/tomtom-api-key-xxxxxx
DATABASE_URL_SECRET=arn:aws:secretsmanager:us-east-1:123456789012:secret:village/database-url-xxxxxx
API_SECRET_KEY_SECRET=arn:aws:secretsmanager:us-east-1:123456789012:secret:village/api-secret-key-xxxxxx

# Application Configuration
DAILY_QUOTA=50000
RATE_LIMIT_DELAY=0.1
LOG_LEVEL=INFO
DB_TYPE=sqlite

# Monitoring Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Development Configuration
ENVIRONMENT=production
DEBUG_MODE=false
DEMO_MODE=false