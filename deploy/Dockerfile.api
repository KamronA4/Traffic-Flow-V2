# Dockerfile for Traffic Data API
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    sqlite3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --system traffic-api && \
    useradd --system --gid traffic-api --shell /bin/false \
    --home-dir /var/lib/traffic-api --create-home traffic-api

# Copy requirements and install Python dependencies
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Copy API files
COPY api/data_api.py .

# Create directories and set permissions
RUN mkdir -p /var/lib/traffic-api /var/log && \
    chown -R traffic-api:traffic-api /var/lib/traffic-api /var/log /app

# Switch to non-root user
USER traffic-api

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Expose port
EXPOSE 8080

# Run the API server
CMD ["python", "data_api.py"]