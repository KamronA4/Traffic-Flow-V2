# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and add your API keys

[secrets]
# Perplexity Sonar API Key (optional - for backwards compatibility)
SONAR_API_KEY = "your_perplexity_sonar_api_key_here"

# Google Gemini API Key (recommended primary)
GOOGLE_API_KEY = "your_google_gemini_api_key_here"

# Primary AI Provider: "gemini" or "sonar" (default: "gemini")
PRIMARY_AI_PROVIDER = "gemini"

# Gemini Model: "gemini-2.5-flash-latest" (free/cheap) or "gemini-2.5-pro-latest" (premium)
GEMINI_MODEL = "gemini-2.5-flash-latest"

# Configuration Notes:
# - Get Gemini API key from: https://aistudio.google.com/app/apikey
# - Get Sonar API key from: https://www.perplexity.ai/settings/api
# - gemini-2.5-flash has a generous free tier and is cost-effective
# - gemini-2.5-pro offers superior reasoning but costs more
# - The app will automatically fall back between providers if one fails